<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background_color">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/search"
        app:titleTextAppearance="@style/MainTitleTextStyle" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_field_height"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_search_field">

        <EditText
            android:id="@+id/inputEditText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="@string/search"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:drawableStart="@drawable/ic_search_24"
            android:drawablePadding="8dp"
            android:drawableTint="@color/yp_black"
            android:paddingHorizontal="12dp"
            android:textColor="@color/yp_black"
            android:textColorHint="@color/yp_black"
            android:textSize="16sp"
            android:fontFamily="@font/ys_display_regular"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/custom_cursor"
            tools:ignore="TouchTargetSizeCheck" />

        <ImageView
            android:id="@+id/clearIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:paddingEnd="12dp"
            android:src="@drawable/ic_clear_24"
            android:visibility="gone"
            app:tint="@color/yp_black" />
    </FrameLayout>

    <!-- Заголовок истории поиска (показывается только в режиме истории) -->
    <TextView
        android:id="@+id/historyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/you_searched"
        android:gravity="center"
        android:textColor="@color/primary_text_color"
        android:textSize="19sp"
        android:fontFamily="@font/ys_display_medium"
        android:paddingTop="18dp"
        android:paddingBottom="12dp"
        android:visibility="gone" />

    <!-- Единый RecyclerView для результатов поиска и истории (по рекомендации ревьюера) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trackRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/padding_standard"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/track_item" />

    <!-- Кнопка очистки истории (показывается только в режиме истории) -->
    <Button
        android:id="@+id/clearHistoryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:text="@string/clear_history"
        app:cornerRadius="54dp"
        android:fontFamily="@font/ys_display_medium"
        android:textSize="14sp"
        app:backgroundTint="@color/primary_text_color"
        android:textColor="@color/screen_background_color"
        android:textAllCaps="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/placeholderContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="top|center_horizontal"
        android:visibility="gone"
        android:layout_marginTop="102dp">

        <ImageView
            android:id="@+id/placeholderImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:src="@drawable/ic_nothing_found" />

        <TextView
            android:id="@+id/placeholderMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="24dp"
            android:gravity="center"
            android:textColor="@color/primary_text_color"
            android:textSize="19sp"
            android:fontFamily="@font/ys_display_regular"
            tools:text="Ничего не нашлось" />

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/refresh_button_text"
            app:cornerRadius="54dp"
            android:visibility="gone"
            android:fontFamily="@font/ys_display_medium"
            android:textSize="14sp"
            app:backgroundTint="@color/primary_text_color"
            android:textColor="@color/screen_background_color"
            android:textAllCaps="false" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/progressBarContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="140dp"
            android:indeterminateTint="@color/yp_blue" />
    </FrameLayout>

</LinearLayout>