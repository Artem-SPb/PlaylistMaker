<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/medialibraryFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.artspb.playlistmaker.search.ui.SearchFragment"
        android:label="SearchFragment"
        tools:layout="@layout/fragment_search">
        
        <action
            android:id="@+id/action_searchFragment_to_audioPlayerFragment"
            app:destination="@id/audioPlayerFragment" />
    </fragment>

    <fragment
        android:id="@+id/medialibraryFragment"
        android:name="com.artspb.playlistmaker.medialibrary.ui.MedialibraryFragment"
        android:label="MedialibraryFragment"
        tools:layout="@layout/fragment_medialibrary">
        <action
            android:id="@+id/action_medialibraryFragment_to_audioPlayerFragment"
            app:destination="@id/audioPlayerFragment" />
        <action
            android:id="@+id/action_medialibraryFragment_to_createPlaylistFragment"
            app:destination="@id/createPlaylistFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.artspb.playlistmaker.settings.ui.SettingsFragment"
        android:label="SettingsFragment"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/audioPlayerFragment"
        android:name="com.artspb.playlistmaker.player.ui.AudioPlayerFragment"
        android:label="AudioPlayerFragment"
        tools:layout="@layout/fragment_audio_player">
        <argument
            android:name="track"
            app:argType="com.artspb.playlistmaker.search.domain.models.Track" />
        <action
            android:id="@+id/action_audioPlayerFragment_to_createPlaylistFragment"
            app:destination="@id/createPlaylistFragment" />
    </fragment>

    <fragment
        android:id="@+id/createPlaylistFragment"
        android:name="com.artspb.playlistmaker.medialibrary.ui.CreatePlaylistFragment"
        android:label="CreatePlaylistFragment"
        tools:layout="@layout/fragment_create_playlist" />

</navigation>
